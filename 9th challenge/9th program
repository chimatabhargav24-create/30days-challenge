#include<stdio.h>
#define rows 5
#define cols 8
void initializeseats(int seats[rows][cols]);
void displayseats(int seats[rows][cols]);
int bookseat(int seats[rows][cols],int row,int col);
int cancelseat(int seats[rows][cols],int row,int col);
int reservegroup(int seats[rows][cols],int groupsize);
void displayreport(int seats[rows][cols]);
int main()
{
int seats[rows][cols];
int choice,row,col,groupsize;
initializeseats(seats);
do
{
printf("\n===== theatre seat booking=====\n");
printf("1.display seats\n");
printf("2.book one seat\n");
printf("3.cancel booking\n");
printf("4.group reservation\n");
printf("5.occupancy report\n");
printf("6.exit\n");
printf("enter your choice: ");
scanf("%d",&choice);
switch(choice)
{
case 1:
displayseats(seats);
break;
case 2:
printf("enter row (1-5): ");
scanf("%d",&row);
printf("enter seat (1-8): ");
scanf("%d",&col);
if(bookseat(seats,row,col)==1)
printf("seat booked successfully\n");
else
printf("booking failed\n");
break;
case 3:
printf("enter row (1-5): ");
scanf("%d",&row);
printf("enter seat (1-8): ");
scanf("%d",&col);
if(cancelseat(seats,row,col)==1)
printf("booking cancelled successfully\n");
else
printf("cancellation failed\n");
break;
case 4:
printf("enter group size (2-8): ");
scanf("%d",&groupsize);
if(reservegroup(seats,groupsize)==1)
printf("group reservation successful\n");
else
printf("group reservation failed\n");
break;
case 5:
displayreport(seats);
break;
case 6:
printf("thank you have a nice day\n");
break;
default:
printf("invalid choice\n");
}
}
while(choice!=6);
return 0;
}
void initializeseats(int seats[rows][cols])
{
int i,j;
for(i=0;i<rows;i++)
{
for(j=0;j<cols;j++)
{
seats[i][j]=0;
}
}
}
void displayseats(int seats[rows][cols])
{
int i,j;
printf("\n0=available,1=booked\n");
printf("       ");
for(j=0;j<cols;j++)
{
printf("%d ",j+1);
}
printf("\n");
for(i=0;i<rows;i++)
{
printf("row %d: ",i+1);
for(j=0;j<cols;j++)
{
printf("%d ",seats[i][j]);
}
printf("\n");
}
}
int bookseat(int seats[rows][cols],int row,int col)
{
if(row<1||row>5||col<1||col>8)
{
return 0;
}
row=row-1;
col=col-1;
if(seats[row][col]==0)
{
seats[row][col]=1;
return 1;
}
return 0;
}
int cancelseat(int seats[rows][cols],int row,int col)
{
if(row<1||row>5||col<1||col>8)
{
return 0;
}
row=row-1;
col=col-1;
if(seats[row][col]==1)
{
seats[row][col]=0;
return 1;
}
return 0;
}
int reservegroup(int seats[rows][cols],int groupsize)
{
int i,j,k;
int count;
if(groupsize<2||groupsize>8)
{
return 0;
}
for(i=0;i<rows;i++)
{
for(j=0;j<=cols-groupsize;j++)
{
count=0;
for(k=0;k<groupsize;k++)
{
if(seats[i][j+k]==0)
{
count++;
}
}
if(count==groupsize)
{
for(k=0;k<groupsize;k++)
{
seats[i][j+k]=1;
}
printf("allocated row: %d\n",i+1);
printf("first seat: %d\n",j+1);
return 1;
}
}
}
return 0;
}
void displayreport(int seats[rows][cols])
{
int i,j;
int booked=0;
int available;
int rowcount[rows]={0};
int highest=0;
float percentage;
for(i=0;i<rows;i++)
{
for(j=0;j<cols;j++)
{
if(seats[i][j]==1)
{
booked++;
rowcount[i]++;
}
}
}
available=40-booked;
percentage=(booked*100.0)/40;
for(i=0;i<rows;i++)
{
if(rowcount[i]>highest)
{
highest=rowcount[i];
}
}
printf("\n=====occupancy report=====\n");
printf("total seats: 40\n");
printf("booked seats: %d\n",booked);
printf("available seats: %d\n",available);
printf("occupancy percentage: %.2f%%\n",percentage);
printf("busiest row(s): ");
if(highest==0)
{
printf("none (no seats booked)\n");
}
else
{
for(i=0;i<rows;i++)
{
if(rowcount[i]==highest)
{
printf("%d ",i+1);
}
}
printf("\nbooked seats in busiest row: %d\n",highest);
}
}
